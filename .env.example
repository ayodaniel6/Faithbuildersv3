# Faithbuilders — environment variables
#
# Copy this file to ".env" and fill in real values:
#     cp .env.example .env
#
# The real ".env" file is git-ignored and must never be committed.

# --- Required ---

# A long, random, secret string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-value

# "True" during local development, "False" in production.
DEBUG=True

# Comma-separated hostnames the site may be served from.
# Local development:
ALLOWED_HOSTS=localhost,127.0.0.1
# Production example:
# ALLOWED_HOSTS=faithbuilders.org,www.faithbuilders.org

# --- Production only ---

# Comma-separated origins trusted for POST/CSRF (include the scheme).
# Required once DEBUG=False and the site is served over HTTPS.
# CSRF_TRUSTED_ORIGINS=https://faithbuilders.org,https://www.faithbuilders.org
