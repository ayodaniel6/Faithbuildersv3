# Copy this file to .env and fill in real values for local development.

# Django secret key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Set to "True" for local development, "False" in production.
DEBUG=True

# Comma-separated list of hosts/domains this site can serve.
ALLOWED_HOSTS=127.0.0.1,localhost
